# Partner credentials — request from api@qobuz.com
QOBUZ_APP_ID=
QOBUZ_APP_SECRET=

# User credentials. Either provide username + MD5-hashed password and let the
# connector log in for you, or paste a previously-issued user_auth_token.
QOBUZ_USERNAME=
QOBUZ_PASSWORD_MD5=
QOBUZ_USER_AUTH_TOKEN=

# Optional: default streaming format. 5=MP3 320, 6=FLAC CD, 7=FLAC 24/96, 27=Hi-Res 24/192
QOBUZ_DEFAULT_FORMAT_ID=27

# Optional: where to cache the user_auth_token between runs.
# QOBUZ_TOKEN_CACHE_DIR=~/.cache/qobuz-connector
